
{
    "manifest_version": 3,
    "name": "NetScope - Website Monitor",
    "version": "1.1.0",
    "description": "Monitor website performance and analyze loading issues.",

    "permissions" : [
        "activeTab",
        "scripting"
    ],

    "host_permissions":[
        "http://127.0.0.1:8000/*"
    ],

    "action": {
        "default_popup": "popup.html",
        "default_title": "NetScope"
    },

    "background": {
        "service_worker": "background.js"
    }
}
